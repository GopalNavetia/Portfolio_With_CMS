# Copy this file to application.properties and fill in your own values.
# application.properties is gitignored and should never be committed.

spring.datasource.url=jdbc:mysql://localhost:3306/portfolio_cms?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
spring.datasource.username=root
spring.datasource.password=your_mysql_password_here

spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.open-in-view=false

jwt.secret=replace-with-a-random-string-of-at-least-32-characters
jwt.expiration-ms=86400000

admin.username=admin
admin.password=your_chosen_password

server:
port: 8080